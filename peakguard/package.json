{
  "name": "peakguard",
  "displayName": "PeakGuard",
  "description": "Know when AI API costs spike. Avoid peak hours. Cut your LLM bill.",
  "version": "1.4.0",
  "publisher": "nagvera",
  "repository": {
    "type": "git",
    "url": "https://github.com/macdev-stdmyapis01/ai-pulse"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "deepseek",
    "api",
    "cost",
    "peak",
    "pricing",
    "cursor",
    "llm",
    "ai"
  ],
  "icon": "icon.png",
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "peakGuard.openPanel",
        "title": "Open Panel",
        "category": "PeakGuard"
      },
      {
        "command": "peakGuard.switchProvider",
        "title": "Switch Provider",
        "category": "PeakGuard"
      },
      {
        "command": "peakGuard.addProvider",
        "title": "Add Provider",
        "category": "PeakGuard"
      },
      {
        "command": "peakGuard.refresh",
        "title": "Refresh",
        "category": "PeakGuard"
      }
    ],
    "configuration": {
      "title": "PeakGuard",
      "properties": {
        "peakGuard.activeProvider": {
          "type": "string",
          "default": "deepseek-v4-flash",
          "description": "ID of the currently active provider"
        },
        "peakGuard.warningMinutes": {
          "type": "number",
          "default": 20,
          "minimum": 5,
          "maximum": 60,
          "description": "Minutes before peak to show approaching state"
        },
        "peakGuard.showPrice": {
          "type": "boolean",
          "default": true,
          "description": "Show current price per 1M tokens in the status bar"
        },
        "peakGuard.currency": {
          "type": "string",
          "enum": [
            "USD",
            "EUR"
          ],
          "default": "USD",
          "description": "Currency for price display"
        },
        "peakGuard.displayTimezone": {
          "type": "string",
          "default": "auto",
          "description": "Timezone for displaying peak window times. Use 'auto' to detect from your OS, or set an explicit timezone like 'America/New_York'. Useful when using Remote SSH where the server timezone differs from your local machine."
        },
        "peakGuard.providers": {
          "type": "array",
          "default": [],
          "description": "Custom provider definitions. These merge with and can override bundled providers.",
          "items": {
            "type": "object",
            "required": [
              "id",
              "name",
              "model",
              "shortLabel",
              "pricing",
              "peak_windows"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "model": {
                "type": "string"
              },
              "shortLabel": {
                "type": "string"
              },
              "timezone": {
                "type": "string"
              },
              "peak_pricing_active": {
                "type": "boolean"
              },
              "peak_pricing_announced": {
                "type": "boolean"
              },
              "warning_minutes": {
                "type": "number"
              },
              "pricing": {
                "type": "object",
                "properties": {
                  "offpeak": {
                    "type": "object",
                    "properties": {
                      "input_miss": {
                        "type": "number"
                      },
                      "input_hit": {
                        "type": "number"
                      },
                      "output": {
                        "type": "number"
                      }
                    }
                  },
                  "peak": {
                    "type": "object",
                    "properties": {
                      "input_miss": {
                        "type": "number"
                      },
                      "input_hit": {
                        "type": "number"
                      },
                      "output": {
                        "type": "number"
                      }
                    }
                  }
                }
              },
              "peak_windows": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "start_utc": {
                      "type": "string"
                    },
                    "end_utc": {
                      "type": "string"
                    }
                  }
                }
              },
              "source": {
                "type": "string"
              },
              "last_verified": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.3.0"
  }
}
